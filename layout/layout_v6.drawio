15" value="6S 구역 4~6열 (Large box)" style="text;html=1;align=center;verticalAlign=middle;fontSize=9;fontStyle=1;fontColor=#047857;" vertex="1" parent="1"><mxGeometry x="538.0" y="388.0" width="208.0" height="20" as="geometry"/></mxCell><mxCell id="c16" value="에이징 AS/RS 6열 × 4단 = 24칸 (칸 크기 동일 · 구역별 12칸) · 보관 중 온도 감시(가상)" style="text;html=1;align=center;verticalAlign=middle;fontSize=11;fontStyle=1;fontColor=#1D4ED8;" vertex="1" parent="1"><mxGeometry x="318.0" y="250.0" width="480.0" height="20" as="geometry"/></mxCell><mxCell id="c17" value="NG 라인 (2차 분리 ↓ · 메인 NG + 재검사 NG)" style="text;html=1;align=center;verticalAlign=middle;fontSize=9;fontStyle=0;fontColor=#B91C1C;" vertex="1" parent="1"><mxGeometry x="1310.0" y="478.0" width="240.0" height="20" as="geometry"/></mxCell><mxCell id="c18" value="Project C 인계&#xa;4S = 작은 박스&#xa;6S = 큰 박스" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F1F5F9;strokeColor=#94A3B8;fontSize=9;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="34.0" y="322.0" width="88.0" height="88.0" as="geometry"/></mxCell><mxCell id="c19" value="비전&#xa;(D1519)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#38BDF8;fontSize=9;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="166.0" y="382.0" width="32.0" height="24.0" as="geometry"/></mxCell><mxCell id="c20" value="RFID ①&#xa;D1510~17" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#38BDF8;fontSize=9;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="230.0" y="326.0" width="40.0" height="24.0" as="geometry"/></mxCell><mxCell id="c21" value="STEP 01 스토퍼 · 종류 판별 → 구역 지정" style="text;html=1;align=center;verticalAlign=middle;fontSize=9;fontStyle=0;fontColor=#0369A1;" vertex="1" parent="1"><mxGeometry x="94.0" y="414.0" width="240.0" height="20" as="geometry"/></mxCell><mxCell id="c22" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#BFDBFE;strokeColor=#2563EB;fontSize=11;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="342.0" y="308.0" width="396.0" height="12.0" as="geometry"/></mxCell><mxCell id="c23" value="입고면 · 크레인 A (M1600) — 종류별 구역 입고" style="text;html=1;align=center;verticalAlign=middle;fontSize=9;fontStyle=0;fontColor=#1D4ED8;" vertex="1" parent="1"><mxGeometry x="358.0" y="280.0" width="400.0" height="20" as="geometry"/></mxCell><mxCell id="c24" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#BAE6FD;strokeColor=#0284C7;fontSize=11;fontStyle=0;" vertex="1" parent="1"><mxGeometry x="334.0" y="412.0" width="420.0" height="12.0" as="geometry"/></mxCell><mxCell id="c25" value="출고면 · 크레인 B (M1601) — 모든 팩 동쪽 출구 (발열 우선 → EDD)" style="text;html=1;align=center;verticalAlign=middle;fontSize=9;fontStyle=0;fontColor=#0369A1;" vertex="1" parent="1"><mxGeometry x="338.0" y="428.0" width="440.0" height="20" as="geometry"/></mxCell><mxCell id="c26" value="M1690&#xa;발열 격리&#xa;X1902/D1902&#xa;DB ISO" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;fontSize=9;fontStyle=1;dashed=1;" vertex="1" parent="1"><mxGeometry x="804.0" y="454.0" width="52.0" height="52.0" as="geometry"/></mxCell><mxCell id="c27" value="PW" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#10B981;fontSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="816.0" y="352.0" width="28.0" height="28.0" as="geometry"/></mxCell><mxCell id="c28" value="1차 분리&#xa;M1660 / M1661" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#10B981;fontSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="800.0" y="314.0" width="48.0" height="24.0" as="geometry"/></mxCell><mxCell id="c29" value="발열 ↓" style="text;html=1;align=center;verticalAlign=middle;fontSize=9;fontStyle=1;fontColor=#B91C1C;" vertex="1" parent="1"><mxGeometry x="726.0" y="446.0" width="80.0" height="20" as="geometry"/></mxCell><mxCell id="c30" value="STEP 03&#xa;메인 검사&#xa;OCV·IR·온도&#xa;M1700" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;fontSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="866.0" y="342.0" width="48.0" height="48.0" as="geometry"/></mxCell><mxCell id="c31" value="RFID ②&#xa;D1520~27" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#38BDF8;fontSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="868.0" y="316.0" width="28.0" height="20.0" as="geometry"/></mxCell><mxCell id="c32" value="1차 측정 → D1700~03" style="text;html=1;align=center;verticalAlign=middle;fontSize=9;fontStyle=0;fontColor=#92400E;" vertex="1" parent="1"><mxGeometry x="810.0" y="286.0" width="160.0" height="20" as="geometry"/></mxCell><mxCell id="c33" value="M1720" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;fontSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="956.0" y="380.0" width="28.0" height="16.0" as="geometry"/></mxCell><mxCell id="c34" value="재검사 라인 (RETEST + 메인 NG) · 정치 없이 연속 · D1800" style="text;html=1;align=left;verticalAlign=middle;fontSize=9;fontStyle=1;fontColor=#B45309;" vertex="1" parent="1"><mxGeometry x="990.0" y="466.0" width="360.0" height="20" as="geometry"/></mxCell><mxCell id="c35" value="→ 재검사기 앞 줄 서기 · 분기점까지 차면 M1800" style="text;html=1;align=left;verticalAlign=middle;fontSize=8;fontStyle=0;fontColor=#B45309;" vertex="1" parent="1"><mxGeometry x="990.0" y="412.0" width="360.0" height="20" as="geometry"/></mxCell><mxCell id="c36" value="재검사&#xa;OCV·IR·온도&#xa;M1730&#xa;D1730~33" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#F59E0B;fontSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1190.0" y="422.0" width="48.0" height="48.0" as="geometry"/></mxCell><mxCell id="c37" value="RFID ③&#xa;D1530~37" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#38BDF8;fontSize=7;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1200.0" y="400.0" width="28.0" height="18.0" as="geometry"/></mxCell><mxCell id="c38" value="PW" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#10B981;fontSize=8;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1276.0" y="432.0" width="28.0" height="28.0" as="geometry"/></mxCell><mxCell id="c39" value="2차 분리 (Pop-up Wheel): ↑ M1731 GOOD 합류 / ↓ M1732 NG OUT" style="text;html=1;align=left;verticalAlign=middle;fontSize=9;fontStyle=1;fontColor=#047857;" vertex="1" parent="1"><mxGeometry x="1312.0" y="436.0" width="280.0" height="20" as="geometry"/></mxCell><mxCell id="c40" value="↓ 재검사 GOOD 합류 (X1903 간격 확인)" style="text;html=1;align=center;verticalAlign=middle;fontSize=9;fontStyle=0;fontColor=#B45309;" vertex="1" parent="1"><mxGeometry x="1194.0" y="328.0" width="240.0" height="20" as="geometry"/></mxCell><mxCell id="c41" value="메인 라인: GOOD → GOOD OUT / RETEST·NG → M1720 (M1710 라인 없음)" style="text;html=1;align=center;verticalAlign=middle;fontSize=9;fontStyle=1;fontColor=#047857;" vertex="1" parent="1"><mxGeometry x="910.0" y="300.0" width="360.0" height="20" as="geometry"/></mxCell><mxCell id="c42" value="GOOD OUT&#xa;X1900 → D1900" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#10B981;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1590.0" y="346.0" width="104.0" height="40.0" as="geometry"/></mxCell><mxCell id="c43" value="NG OUT&#xa;X1901 → D1901" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FEE2E2;strokeColor=#EF4444;fontSize=10;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1590.0" y="490.0" width="104.0" height="40.0" as="geometry"/></mxCell><mxCell id="c44" value="STEP 05 게이트 · HMI (M1920 리셋)" style="text;html=1;align=center;verticalAlign=middle;fontSize=10;fontStyle=1;fontColor=#047857;" vertex="1" parent="1"><mxGeometry x="1522.0" y="306.0" width="240.0" height="20" as="geometry"/></mxCell><mxCell id="c45" value="v6 (v5 + 정치 버퍼 삭제)&#xa;· 랙 1개 · 크레인 2대 (A 입고 / B 출고)&#xa;· 검사기 2대: 메인(RFID②) · 재검사(RFID③), 둘 다 OCV·IR·온도&#xa;· 1차 분리: 발열 팩 ↓ 격리 (DB ISO) / 정상 → 메인 검사&#xa;· 2차 분리: 재검사 후 GOOD ↑ 합류 / NG ↓ NG OUT&#xa;· 메인 NG도 재검사 라인 → 재검사기 통과 (계측 생략) → NG OUT&#xa;· 삭제: 정치 버퍼 8칸(v6) · M1710 라인 · M1650 · 루프백 · BYPASS&#xa;· 랙 6열 × 4단 = 24칸, 칸 크기 동일 (4S 1~3열 · 6S 4~6열)&#xa;· 카운터 D1900 GOOD · D1901 NG · D1902 격리 · D1903 합계 · D1904 수율" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;fontSize=10;fontStyle=0;dashed=1;" vertex="1" parent="1"><mxGeometry x="1334.0" y="86.0" width="384.0" height="148.0" as="geometry"/></mxCell><mxCell id="c46" value="Project B 상면 레이아웃 — v6 (정치 버퍼 없는 연속 재검사 라인 · 1차/2차 분리) · 1칸 = 1 m" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="42.0" y="10.0" width="960.0" height="20" as="geometry"/></mxCell><mxCell id="c47" value="흐름: 투입 → RFID①·비전 → 랙 4S/6S 숙성(온도 감시) → 크레인 B 동쪽 출구 → 1차 분리(발열 ↓ 격리) → RFID② 메인 검사 → GOOD / RETEST·NG → 재검사 라인(연속) → RFID③ 재검사기 → 2차 분리(GOOD ↑ 합류 / NG ↓)" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontStyle=0;fontColor=#475569;" vertex="1" parent="1"><mxGeometry x="42.0" y="36.0" width="1360.0" height="20" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>